<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartAttend</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/attendence.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">✦ SmartAttend</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Student")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="StudentPortal" asp-action="Index">My attendance</a></li> }
                        else if (User.Identity?.IsAuthenticated == true) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Dashboard</a></li> }
                        @if (User.IsInRole("Administrator")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Students" asp-action="Index">Students</a></li><li class="nav-item"><a class="nav-link text-dark" asp-controller="SchoolManagement" asp-action="Index">School setup</a></li><li class="nav-item"><a class="nav-link text-dark" asp-controller="UserAccounts" asp-action="Index">Accounts</a></li> }
                        @if (User.IsInRole("Administrator") || User.IsInRole("Teacher")) { <li class="nav-item"><a class="nav-link text-dark" asp-controller="Attendance" asp-action="Index">Attendance</a></li><li class="nav-item"><a class="nav-link text-dark" asp-controller="Reports" asp-action="Index">Reports</a></li> }
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true) { <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex"><span class="navbar-text me-3">@User.Identity.Name · @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span><button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button></form> } else { <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Sign in</a> }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (TempData["Error"] is string error) { <div class="alert alert-warning mt-3">@error</div> }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SmartAttend
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
