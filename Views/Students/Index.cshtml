@model IReadOnlyList<attendence.Models.Student>
@{ ViewData["Title"] = "Students"; }
<style>
 .student-page{max-width:1200px;margin:auto;padding:30px 10px 60px}.student-hero{background:linear-gradient(120deg,#eef4ff,#fff);border:1px solid #e4ecfb;border-radius:18px;padding:30px;margin-bottom:22px}.student-hero h1{font-weight:750;color:#142b50}.student-hero p{color:#70809a;margin:8px 0 0}.student-card{border:0;border-radius:16px;box-shadow:0 8px 26px #19365b0c}.table thead th{font-size:.75rem;color:#73829a;text-transform:uppercase;letter-spacing:.06em;background:#f7f9fc;border:0;padding:15px}.table td{padding:15px;vertical-align:middle}.student-avatar{display:inline-grid;place-items:center;width:36px;height:36px;background:#eaf0ff;color:#385ab5;border-radius:50%;font-weight:700;margin-right:10px}.enrollment{font:600 .82rem ui-monospace,monospace;color:#3f5d95}.class-badge{background:#edf4ff;color:#3962a8;padding:6px 10px;border-radius:30px;font-weight:600}.student-actions{display:flex;gap:7px;justify-content:flex-end}.search-box{max-width:350px}.empty-directory{padding:55px 20px;text-align:center;color:#77859a}.empty-directory .symbol{font-size:35px;color:#84a2e4}.mobile-card{display:none}@@media(max-width:700px){.desktop-table{display:none}.mobile-card{display:block}.student-hero{padding:22px}}
</style>
<div class="student-page">
 <div class="student-hero d-flex flex-wrap justify-content-between align-items-center gap-3"><div><div class="small text-primary fw-bold text-uppercase">Academic directory</div><h1 class="h2 mt-2 mb-0">Students</h1><p>Maintain enrollment records and class assignments.</p></div><a asp-action="Create" class="btn btn-primary px-4 py-2">＋ Register student</a></div>
 @if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
 <section class="card student-card"><div class="card-body p-3 p-md-4"><div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3"><div><h2 class="h5 fw-bold mb-1">Student directory</h2><span class="text-secondary small">@Model.Count student record(s)</span></div><form method="get" class="d-flex gap-2 search-box"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, ID or email" aria-label="Search students"/><button class="btn btn-outline-primary">Search</button></form></div>
 @if (Model.Count == 0) { <div class="empty-directory"><div class="symbol">♙</div><h3 class="h6 fw-bold mt-3">No students found</h3><p class="small">Register your first student or adjust your search.</p><a asp-action="Create" class="btn btn-primary btn-sm">Register student</a></div> }
 else { <div class="table-responsive desktop-table"><table class="table"><thead><tr><th>Student</th><th>Enrollment</th><th>Class</th><th>Contact</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var s in Model) { <tr><td><span class="student-avatar">@s.FullName[..1].ToUpperInvariant()</span><strong>@s.FullName</strong></td><td><span class="enrollment">@s.EnrollmentNumber</span></td><td>@if (!string.IsNullOrWhiteSpace(s.ClassName)) { <span class="class-badge">@s.ClassName · Sem @s.Semester</span> } else { <span class="text-secondary">Unassigned</span> }</td><td><div>@s.Email</div><small class="text-secondary">@s.PhoneNumber</small></td><td><span class="badge text-bg-success">@(s.IsActive ? "Active" : "Inactive")</span></td><td><div class="student-actions"><a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary">Edit</a>@if(s.IsActive){<form asp-action="Delete" asp-route-id="@s.StudentId" method="post" onsubmit="return confirm('Deactivate this student?')"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form>}</div></td></tr> }</tbody></table></div>
 <div class="mobile-card">@foreach (var s in Model) { <article class="border rounded-3 p-3 mb-2"><div class="fw-bold">@s.FullName</div><div class="text-secondary small">@s.EnrollmentNumber · @(s.ClassName ?? "Unassigned")</div><div class="student-actions mt-3"><a asp-action="Edit" asp-route-id="@s.StudentId" class="btn btn-sm btn-outline-primary">Edit</a>@if(s.IsActive){<form asp-action="Delete" asp-route-id="@s.StudentId" method="post" onsubmit="return confirm('Deactivate this student?')"><button class="btn btn-sm btn-outline-danger">Deactivate</button></form>}</div></article> }</div> }
 </div></section>
</div>

