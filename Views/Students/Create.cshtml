@model attendence.Models.StudentFormViewModel
@{ ViewData["Title"] = "Register student"; var isEdit = Model.Student.StudentId != 0; }
<style>
 .form-wrap{max-width:930px;margin:30px auto 60px}.form-hero{margin-bottom:22px}.form-hero h1{font-weight:750;color:#142b50}.registration-card{border:0;border-radius:18px;box-shadow:0 8px 30px #19365b10;overflow:hidden}.registration-card .card-header{background:#fff;border-bottom:1px solid #edf1f7;padding:22px 28px}.registration-card .card-body{padding:28px}.field-label{font-weight:650;font-size:.88rem;color:#273a58;margin-bottom:7px}.field-hint{font-size:.76rem;color:#8290a4;margin-top:5px}.form-control,.form-select{border:1px solid #dce4f0;border-radius:9px;padding:11px 13px;color:#20334f}.form-control:focus,.form-select:focus{border-color:#6688dd;box-shadow:0 0 0 .2rem #6688dd22}.field-block{margin-bottom:22px}.required-mark{color:#e25454}.empty-class{background:#fff8e7;border:1px solid #f6e4b7;color:#8b6820;border-radius:9px;padding:12px 14px;font-size:.84rem}.form-footer{background:#f9fbfe;border-top:1px solid #edf1f7;padding:18px 28px;display:flex;justify-content:space-between;align-items:center;gap:12px}@@media(max-width:600px){.registration-card .card-body{padding:20px}.registration-card .card-header{padding:18px 20px}.form-footer{padding:16px 20px}}
</style>
<div class="form-wrap"><div class="form-hero"><a asp-action="Index" class="text-decoration-none small">← Back to students</a><div class="text-primary text-uppercase small fw-bold mt-4">Student directory</div><h1 class="h2 mt-2">@(isEdit ? "Edit student" : "Register a student")</h1><p class="text-secondary">Add accurate enrollment and contact details for this student.</p></div>
 <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Student.StudentId" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="Student.StudentId" type="hidden"/>
 <section class="card registration-card"><div class="card-header"><strong>Student information</strong><div class="small text-secondary mt-1">Fields marked <span class="required-mark">*</span> are required.</div></div><div class="card-body"><div class="row"><div class="col-md-6 field-block"><label asp-for="Student.EnrollmentNumber" class="field-label">Enrollment number <span class="required-mark">*</span></label><input asp-for="Student.EnrollmentNumber" class="form-control" placeholder="e.g. CS2026-001" autocomplete="off"/><span asp-validation-for="Student.EnrollmentNumber" class="text-danger small"></span><div class="field-hint">Must be unique for each student.</div></div>
 <div class="col-md-6 field-block"><label asp-for="Student.FullName" class="field-label">Full name <span class="required-mark">*</span></label><input asp-for="Student.FullName" class="form-control" placeholder="Student's full name" autocomplete="name"/><span asp-validation-for="Student.FullName" class="text-danger small"></span></div>
 <div class="col-md-6 field-block"><label asp-for="Student.Email" class="field-label">Email address</label><input asp-for="Student.Email" class="form-control" placeholder="student@example.edu" autocomplete="email"/><span asp-validation-for="Student.Email" class="text-danger small"></span></div>
 <div class="col-md-6 field-block"><label asp-for="Student.PhoneNumber" class="field-label">Phone number</label><input asp-for="Student.PhoneNumber" class="form-control" placeholder="+1 555 010 2026" autocomplete="tel"/><span asp-validation-for="Student.PhoneNumber" class="text-danger small"></span></div>
 <div class="col-12 field-block"><label asp-for="Student.ClassId" class="field-label">Class</label>@if (Model.Classes.Count <= 1) { <select asp-for="Student.ClassId" asp-items="Model.Classes" class="form-select"></select><div class="empty-class mt-2">No classes are available yet. You can register the student without a class, then assign one later.</div> } else { <select asp-for="Student.ClassId" asp-items="Model.Classes" class="form-select"></select><div class="field-hint">Select the class this student belongs to.</div> }<span asp-validation-for="Student.ClassId" class="text-danger small"></span></div></div></div>
 <div class="form-footer"><span class="small text-secondary">Student records are stored in SmartAttend.</span><div class="d-flex gap-2"><a asp-action="Index" class="btn btn-light px-3">Cancel</a><button type="submit" class="btn btn-primary px-4">@(isEdit ? "Save changes" : "Register student")</button></div></div></section></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

