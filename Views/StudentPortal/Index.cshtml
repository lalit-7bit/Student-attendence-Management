@model attendence.Models.StudentPortalViewModel
@{ViewData["Title"]="My attendance";}
<div class="py-4"><div class="text-primary small fw-bold text-uppercase">Student workspace</div><h1 class="h2 fw-bold mt-2">Hello, @Model.StudentName</h1><p class="text-secondary">Your attendance record · @Model.EnrollmentNumber</p></div><div class="row g-3 mb-4">@foreach(var item in new[]{("Attendance rate",$"{Model.AttendancePercentage:0.0}%"),("Present",Model.Present.ToString()),("Absent",Model.Absent.ToString()),("Late",Model.Late.ToString())}){<div class="col-6 col-xl-3"><div class="card border-0 shadow-sm"><div class="card-body"><div class="small text-secondary">@item.Item1</div><div class="h2 fw-bold mt-2">@item.Item2</div></div></div></div>}</div><section class="card border-0 shadow-sm"><div class="card-body"><h2 class="h5 fw-bold">Attendance history</h2>@if(Model.Records.Count==0){<p class="text-secondary">No attendance records have been posted yet.</p>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Subject</th><th>Status</th><th>Remarks</th></tr></thead><tbody>@foreach(var row in Model.Records){<tr><td>@row.Date.ToString("dd MMM yyyy") · @row.Period</td><td>@row.Subject <span class="small text-secondary">(@row.ClassName)</span></td><td>@row.Status</td><td>@row.Remarks</td></tr>}</tbody></table></div>}</div></section>
