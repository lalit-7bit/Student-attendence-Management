@model attendence.Models.AttendanceViewModel
@{ ViewData["Title"] = "Attendance"; }
<style>
.att-page{max-width:1160px;margin:28px auto 60px}.att-hero{background:linear-gradient(120deg,#eff5ff,#fff);border:1px solid #e3ecfb;border-radius:18px;padding:26px;margin-bottom:20px}.att-hero h1{color:#17375f;font-weight:750}.att-panel{border:0;border-radius:15px;box-shadow:0 6px 24px #19365b0c}.att-filter{padding:22px}.att-label{font-weight:650;color:#324663;font-size:.83rem;margin-bottom:7px}.att-table th{background:#f6f8fc;color:#74829a;font-size:.73rem;text-transform:uppercase;letter-spacing:.05em}.att-table td,.att-table th{padding:13px;vertical-align:middle}.att-controls{display:flex;gap:7px;flex-wrap:wrap}.att-controls .btn-check+.btn{border-radius:18px!important}.att-select{max-width:140px}.att-note{max-width:240px}.roster-mobile{display:none}@@media(max-width:760px){.roster-desktop{display:none}.roster-mobile{display:block}.att-filter{padding:16px}.att-hero{padding:20px}}
</style>
<div class="att-page">
 <div class="att-hero"><div class="text-primary small text-uppercase fw-bold">Classroom tools</div><h1 class="h2 mt-2 mb-1">Take attendance</h1><p class="text-secondary mb-0">Choose a class and subject to load the active roster. Previously saved marks appear for the selected session.</p></div>
 @if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}
 <section class="card att-panel mb-3"><div class="card-body att-filter"><h2 class="h5 fw-bold mb-3">Session details</h2><form method="get" asp-controller="Attendance" asp-action="Index" class="row g-3 align-items-end"><div class="col-sm-6 col-lg-3"><label class="att-label" for="classId">Class</label><select class="form-select" id="classId" name="classId" asp-items="Model.Classes" onchange="this.form.subjectId.value='';this.form.teacherId.value='';this.form.submit()"><option value="">Choose class</option></select></div><div class="col-sm-6 col-lg-3"><label class="att-label" for="subjectId">Subject</label><select class="form-select" id="subjectId" name="subjectId" asp-items="Model.Subjects" onchange="this.form.teacherId.value='';this.form.submit()"><option value="">Choose subject</option></select></div><div class="col-sm-6 col-lg-2"><label class="att-label" for="date">Date</label><input id="date" name="date" type="date" value="@Model.SessionDate.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="att-label" for="period">Period</label><input id="period" name="period" value="@Model.Period" maxlength="30" class="form-control" placeholder="e.g. 1"/></div><div class="col-sm-6 col-lg-2"><label class="att-label" for="teacherId">Assigned teacher</label><select id="teacherId" name="teacherId" asp-items="Model.Teachers" class="form-select"><option value="">Choose teacher</option></select></div><div class="col-12"><button class="btn btn-outline-primary btn-sm" type="submit">Load roster</button></div></form></div></section>
 @if(!string.IsNullOrWhiteSpace(Model.Notice)){<div class="alert alert-info">@Model.Notice</div>}
 @if(Model.Students.Count>0){<form asp-action="Save" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><input asp-for="ClassId" type="hidden"/><input asp-for="SubjectId" type="hidden"/><input asp-for="TeacherId" type="hidden"/><input asp-for="SessionDate" type="hidden"/><input asp-for="Period" type="hidden"/><section class="card att-panel"><div class="card-body p-3 p-md-4"><div class="d-flex flex-wrap justify-content-between gap-2 mb-3"><div><h2 class="h5 fw-bold mb-1">Class roster</h2><span class="small text-secondary">@Model.Students.Count active student(s) · @Model.SessionDate.ToString("dd MMM yyyy") · Period @Model.Period</span></div><span class="badge text-bg-light align-self-start">Excused marks are excluded from attendance rate</span></div>
 <div class="table-responsive roster-desktop"><table class="table att-table"><thead><tr><th>Enrollment</th><th>Student</th><th>Attendance status</th><th>Remarks (optional)</th></tr></thead><tbody>@for(var i=0;i<Model.Students.Count;i++){<tr><td class="font-monospace small">@Model.Students[i].EnrollmentNumber<input asp-for="Students[i].StudentId" type="hidden"/><input asp-for="Students[i].EnrollmentNumber" type="hidden"/><input asp-for="Students[i].FullName" type="hidden"/></td><td class="fw-semibold">@Model.Students[i].FullName</td><td><select asp-for="Students[i].Status" class="form-select att-select"><option>Present</option><option>Absent</option><option>Late</option><option>Excused</option></select><span asp-validation-for="Students[i].Status" class="text-danger small"></span></td><td><input asp-for="Students[i].Remarks" class="form-control att-note" placeholder="Optional note"/><span asp-validation-for="Students[i].Remarks" class="text-danger small"></span></td></tr>}</tbody></table></div>
 <div class="roster-mobile">@for(var i=0;i<Model.Students.Count;i++){<article class="border rounded-3 p-3 mb-2"><input asp-for="Students[i].StudentId" type="hidden"/><input asp-for="Students[i].EnrollmentNumber" type="hidden"/><input asp-for="Students[i].FullName" type="hidden"/><div class="font-monospace text-secondary small">@Model.Students[i].EnrollmentNumber</div><div class="fw-semibold mb-2">@Model.Students[i].FullName</div><label asp-for="Students[i].Status" class="att-label">Status</label><select asp-for="Students[i].Status" class="form-select mb-2"><option>Present</option><option>Absent</option><option>Late</option><option>Excused</option></select><label asp-for="Students[i].Remarks" class="att-label">Remarks</label><input asp-for="Students[i].Remarks" class="form-control" placeholder="Optional note"/></article>}</div>
 <div class="d-flex justify-content-end mt-3"><button class="btn btn-primary px-4" type="submit">Save attendance</button></div></div></section></form>}
</div>

