@model attendence.Models.SchoolManagementViewModel
@{ViewData["Title"]="School setup";}
<style>.manage-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.manage-card{border:0;border-radius:14px;box-shadow:0 5px 20px #19365b0d}.manage-card .card-header{background:#fff;border-bottom:1px solid #edf0f5;padding:18px 20px}.manage-card .card-body{padding:20px}.manage-row{border-bottom:1px solid #f0f2f6;padding:12px 0}.manage-row:last-child{border:0}.manage-row .form-control,.manage-row .form-select{font-size:.85rem}@@media(max-width:850px){.manage-grid{grid-template-columns:1fr}}</style>
<div class="py-4"><div class="text-primary small fw-bold text-uppercase">Administration</div><h1 class="h2 fw-bold mt-2">School setup</h1><p class="text-secondary">Set up departments, classes, subjects, and teaching assignments. Records with attendance history are retained.</p></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-warning">@error</div>}<div asp-validation-summary="All" class="text-danger"></div>
<div class="manage-grid">
<section class="card manage-card"><div class="card-header"><h2 class="h5 fw-bold mb-0">Institution settings</h2></div><div class="card-body"><form asp-action="SaveSettings" method="post" class="row g-2 align-items-end"><div class="col-md-6"><label asp-for="InstitutionName" class="form-label">Institution name</label><input asp-for="InstitutionName" class="form-control"/></div><div class="col-md-4"><label asp-for="LowAttendanceThreshold" class="form-label">Low attendance alert threshold (%)</label><input asp-for="LowAttendanceThreshold" type="number" min="1" max="100" class="form-control"/></div><div class="col-md-2"><button class="btn btn-primary">Save</button></div></form></div></section>
<section class="card manage-card"><div class="card-header"><h2 class="h5 fw-bold mb-0">Departments</h2></div><div class="card-body"><form asp-action="SaveDepartment" method="post" class="row g-2 mb-3"><input asp-for="Department.Id" type="hidden"/><div class="col"><input asp-for="Department.Name" class="form-control" placeholder="Department name"/></div><div class="col-auto"><button class="btn btn-primary">Add</button></div></form>@foreach(var d in Model.Departments){<form asp-action="SaveDepartment" method="post" class="manage-row d-flex gap-2"><input name="Department.Id" value="@d.Id" type="hidden"/><input name="Department.Name" value="@d.Name" class="form-control"/><button class="btn btn-sm btn-outline-primary">Save</button></form>}</div></section>
<section class="card manage-card"><div class="card-header"><h2 class="h5 fw-bold mb-0">Classes</h2></div><div class="card-body"><form asp-action="SaveClass" method="post" class="row g-2 mb-3"><input asp-for="Class.Id" type="hidden"/><div class="col-12"><select asp-for="Class.DepartmentId" class="form-select"><option value="0">Choose department</option>@foreach(var d in Model.Departments){<option value="@d.Id">@d.Name</option>}</select></div><div class="col-7"><input asp-for="Class.Name" class="form-control" placeholder="Class name"/></div><div class="col-5"><select asp-for="Class.Semester" class="form-select">@for(byte n=1;n<=12;n++){<option value="@n">Semester @n</option>}</select></div><div class="col"><input asp-for="Class.AcademicYear" class="form-control" placeholder="Academic year (e.g. 2026-27)"/></div><div class="col-auto"><button class="btn btn-primary">Add</button></div></form>@foreach(var c in Model.Classes){<form asp-action="SaveClass" method="post" class="manage-row row g-2"><input name="Class.Id" value="@c.Id" type="hidden"/><div class="col-6"><select name="Class.DepartmentId" class="form-select">@foreach(var d in Model.Departments){<option value="@d.Id" selected="@(d.Id==c.DepartmentId)">@d.Name</option>}</select></div><div class="col-6"><input name="Class.Name" value="@c.Name" class="form-control"/></div><div class="col-3"><input name="Class.Semester" type="number" min="1" max="12" value="@c.Semester" class="form-control"/></div><div class="col-5"><input name="Class.AcademicYear" value="@c.AcademicYear" class="form-control"/></div><div class="col-4"><button class="btn btn-sm btn-outline-primary">Save</button></div></form>}</div></section>
<section class="card manage-card"><div class="card-header"><h2 class="h5 fw-bold mb-0">Teachers</h2></div><div class="card-body"><form asp-action="SaveTeacher" method="post" class="row g-2 mb-3"><input asp-for="Teacher.Id" type="hidden"/><div class="col-6"><input asp-for="Teacher.FullName" class="form-control" placeholder="Full name"/></div><div class="col-6"><input asp-for="Teacher.Email" class="form-control" placeholder="Email"/></div><div class="col-12"><button class="btn btn-primary">Add teacher</button></div></form>@foreach(var t in Model.Teachers){<div class="manage-row"><form asp-action="SaveTeacher" method="post" class="d-flex gap-2"><input name="Teacher.Id" value="@t.Id" type="hidden"/><input name="Teacher.FullName" value="@t.FullName" class="form-control"/><input name="Teacher.Email" value="@t.Email" class="form-control"/><button class="btn btn-sm btn-outline-primary">Save</button></form><div class="d-flex justify-content-between align-items-center mt-2"><small class="text-secondary">@(t.IsActive?"Active":"Inactive")</small>@if(t.IsActive){<form asp-action="DeactivateTeacher" method="post" onsubmit="return confirm('Deactivate this teacher? Their attendance history will remain.')"><input name="id" value="@t.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Deactivate</button></form>}</div></div>}</div></section>
<section class="card manage-card"><div class="card-header"><h2 class="h5 fw-bold mb-0">Subjects &amp; assignments</h2></div><div class="card-body"><form asp-action="SaveSubject" method="post" class="row g-2 mb-3"><input asp-for="Subject.Id" type="hidden"/><div class="col-12"><select asp-for="Subject.ClassId" class="form-select"><option value="0">Choose class</option>@foreach(var c in Model.Classes){<option value="@c.Id">@c.Department · @c.Name · Sem @c.Semester</option>}</select></div><div class="col-4"><input asp-for="Subject.Code" class="form-control" placeholder="Code"/></div><div class="col-8"><input asp-for="Subject.Name" class="form-control" placeholder="Subject name"/></div><div class="col-8"><select asp-for="Subject.TeacherIds" multiple size="3" class="form-select">@foreach(var t in Model.Teachers.Where(x=>x.IsActive)){<option value="@t.Id">@t.FullName</option>}</select></div><div class="col-4"><button class="btn btn-primary">Add subject</button></div></form>@foreach(var s in Model.Subjects){<form asp-action="SaveSubject" method="post" class="manage-row row g-2"><input name="Subject.Id" value="@s.Id" type="hidden"/><div class="col-12"><select name="Subject.ClassId" class="form-select">@foreach(var c in Model.Classes){<option value="@c.Id" selected="@(c.Id==s.ClassId)">@c.Department · @c.Name · Sem @c.Semester</option>}</select></div><div class="col-3"><input name="Subject.Code" value="@s.Code" class="form-control"/></div><div class="col-5"><input name="Subject.Name" value="@s.Name" class="form-control"/></div><div class="col-4"><button class="btn btn-sm btn-outline-primary">Save</button></div><div class="col-8"><select name="Subject.TeacherIds" multiple size="3" class="form-select">@foreach(var t in Model.Teachers.Where(x=>x.IsActive)){<option value="@t.Id" selected="@(s.TeacherIds?.Split(',').Contains(t.Id.ToString())==true)">@t.FullName</option>}</select></div><div class="col-4 small text-secondary align-self-center">@(s.TeacherName??"No teacher assigned")</div></form>}</div></section>
</div>



