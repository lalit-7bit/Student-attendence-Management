@model attendence.Models.UserAccountForm
@{ViewData["Title"]="User accounts";var accountRows=ViewBag.Accounts as IReadOnlyList<attendence.Models.UserAccountRow>??Array.Empty<attendence.Models.UserAccountRow>();var studentRows=ViewBag.Students as IReadOnlyList<attendence.Models.Student>??Array.Empty<attendence.Models.Student>();var teacherRows=ViewBag.Teachers as IReadOnlyList<attendence.Models.TeacherRow>??Array.Empty<attendence.Models.TeacherRow>();}
<div class="py-4"><div class="small text-primary fw-bold text-uppercase">Security administration</div><h1 class="h2 fw-bold mt-2">User accounts</h1><p class="text-secondary">Create profile-linked teacher and student accounts. Passwords are hashed and privileged self-registration is disabled.</p></div>
@if(TempData["Success"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-warning">@error</div>}
<div class="row g-3"><div class="col-lg-5"><section class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5 fw-bold">Create account</h2><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" autocomplete="off"/><span asp-validation-for="Email" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Password" class="form-label">Temporary password</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger small"></span><div class="form-text">12+ characters, upper and lower case, number, symbol.</div></div><div class="mb-3"><label asp-for="Role" class="form-label">Role</label><select asp-for="Role" class="form-select" id="accountRole"><option>Teacher</option><option>Student</option></select></div><div class="mb-3" id="teacherProfile"><label asp-for="TeacherId" class="form-label">Teacher profile</label><select asp-for="TeacherId" class="form-select"><option value="">Choose teacher</option>@foreach(var t in teacherRows){<option value="@t.Id">@t.FullName · @t.Email</option>}</select><span asp-validation-for="TeacherId" class="text-danger small"></span></div><div class="mb-3 d-none" id="studentProfile"><label asp-for="StudentId" class="form-label">Student profile</label><select asp-for="StudentId" class="form-select"><option value="">Choose student</option>@foreach(var s in studentRows){<option value="@s.StudentId">@s.EnrollmentNumber · @s.FullName</option>}</select><span asp-validation-for="StudentId" class="text-danger small"></span></div><button class="btn btn-primary">Create account</button></form></div></section></div>
<div class="col-lg-7"><section class="card border-0 shadow-sm"><div class="card-body p-0"><div class="p-4"><h2 class="h5 fw-bold">Registered accounts</h2></div>@if(accountRows.Count==0){<div class="p-4 text-secondary">No user accounts have been created.</div>}else{<div class="table-responsive"><table class="table align-middle"><thead class="table-light"><tr><th>Email</th><th>Role</th><th>Linked profile</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var a in accountRows){<tr><td>@a.Email</td><td>@a.Role</td><td>@(a.LinkedName??"—")</td><td>@(a.IsActive?"Active":"Inactive")</td><td>@if(a.IsActive&&a.Role!="Administrator"){<form asp-action="Deactivate" method="post" onsubmit="return confirm('Deactivate this account?')"><input name="id" value="@a.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">Deactivate</button></form>}</td></tr>}</tbody></table></div>}</div></section></div></div>
@section Scripts {<script>document.getElementById('accountRole').addEventListener('change',function(){document.getElementById('teacherProfile').classList.toggle('d-none',this.value!=='Teacher');document.getElementById('studentProfile').classList.toggle('d-none',this.value!=='Student');});</script>}
