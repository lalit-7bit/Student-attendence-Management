@model attendence.Models.AttendanceReportViewModel
@{ ViewData["Title"]="Attendance reports"; }
<div class="py-4"><div class="text-uppercase small text-primary fw-bold">Insights</div><h1 class="h2 fw-bold mt-2">Attendance reports</h1><p class="text-secondary">Filter the recorded register by class, subject, student, date range, and status.</p></div>
@if(Model.Error is not null){<div class="alert alert-warning">@Model.Error</div>}
<section class="card border-0 shadow-sm mb-3"><div class="card-body p-4"><form method="get" asp-action="Index" class="row g-3 align-items-end"><div class="col-sm-6 col-lg-2"><label class="form-label">Class</label><select name="ClassId" asp-items="Model.Classes" class="form-select" onchange="this.form.SubjectId.value='';this.form.submit()"><option value="">All classes</option></select></div><div class="col-sm-6 col-lg-2"><label class="form-label">Subject</label><select name="SubjectId" asp-items="Model.Subjects" class="form-select"><option value="">All subjects</option></select></div><div class="col-sm-6 col-lg-2"><label class="form-label">Student</label><select name="StudentId" asp-items="Model.Students" class="form-select"><option value="">All students</option></select></div><div class="col-sm-6 col-lg-2"><label class="form-label">From</label><input name="StartDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">To</label><input name="EndDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control"/></div><div class="col-sm-6 col-lg-2"><label class="form-label">Status</label><select name="Status" class="form-select"><option value="">All statuses</option>@foreach(var status in new[]{"Present","Absent","Late","Excused"}){<option value="@status" selected="@(Model.Status==status)">@status</option>}</select></div><div class="col-12 d-flex gap-2"><button class="btn btn-primary">Apply filters</button><a class="btn btn-outline-primary" asp-action="Export" asp-route-ClassId="@Model.ClassId" asp-route-SubjectId="@Model.SubjectId" asp-route-StudentId="@Model.StudentId" asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")" asp-route-Status="@Model.Status">Export CSV</a></div></form></div></section>
<section class="card border-0 shadow-sm"><div class="card-body p-0"><div class="d-flex justify-content-between p-4 pb-2"><div><h2 class="h5 fw-bold">Attendance register</h2><p class="small text-secondary">@Model.Rows.Count record(s). Attendance rate uses Present + Late / Present + Absent + Late; Excused is excluded.</p></div></div>@if(Model.Rows.Count==0){<div class="text-center text-secondary p-5">No attendance records match the selected filters.</div>}else{<div class="table-responsive"><table class="table table-hover mb-0 align-middle"><thead class="table-light"><tr><th>Date</th><th>Class / subject</th><th>Student</th><th>Status</th><th>Remarks</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td>@row.Date.ToString("dd MMM yyyy")<div class="small text-secondary">Period @row.Period</div></td><td>@row.ClassName<div class="small text-secondary">@row.Subject</div></td><td>@row.StudentName<div class="small text-secondary font-monospace">@row.EnrollmentNumber</div></td><td><span class="badge @(row.Status=="Present"?"text-bg-success":row.Status=="Absent"?"text-bg-danger":row.Status=="Late"?"text-bg-warning":"text-bg-secondary")">@row.Status</span></td><td>@row.Remarks</td></tr>}</tbody></table></div>}</div></section>
<section class="card border-0 shadow-sm mt-3"><div class="card-body p-4"><h2 class="h5 fw-bold">Low-attendance alerts</h2><p class="small text-secondary">Active students below the configured @Model.LowAttendanceThreshold.ToString("0.#")% threshold, calculated over all valid historical marks.</p>@if(Model.LowAttendance.Count==0){<div class="text-secondary small">No students are currently below the configured threshold.</div>}else{<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Enrollment</th><th>Student</th><th>Class</th><th>Attendance</th></tr></thead><tbody>@foreach(var s in Model.LowAttendance){<tr><td class="font-monospace">@s.EnrollmentNumber</td><td>@s.StudentName</td><td>@(s.ClassName??"Unassigned")</td><td class="text-danger fw-semibold">@s.Percentage.ToString("0.0")%</td></tr>}</tbody></table></div>}</div></section>
